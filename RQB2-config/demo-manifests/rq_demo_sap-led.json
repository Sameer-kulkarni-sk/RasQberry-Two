{
  "id": "sap-led",
  "name": "SAP Quantum LED",
  "category": "led-demo",
  "description": "Display SAP text on the NeoPixel LED matrix with quantum-generated color cycles",
  "keywords": ["sap", "led", "quantum", "neopixel", "color", "display", "matrix"],

  "entrypoint": {
    "type": "script",
    "launcher": "rq_sap_led_auto.sh"
  },

  "install": {
    "preinstalled": true
  },

  "needs_hw": {
    "leds": true,
    "display": "none"
  },
  "needs_ibm_token": "none",
  "browser_based": false,
  "loop_ok": true,
  "timeout": 30,

  "icon": {
    "type": "system",
    "path": "video-display"
  },

  "menu": {
    "show": true,
    "order": 95
  },

  "desktop": {
    "show": true,
    "terminal": true
  }
}
